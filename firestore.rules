        allow create: if isOwner(userId) && isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'localId', 'partyType', 'partyLocalId', 'sourceType', 'sourceId', 'amountPaise', 'paymentMethod', 'executionStatus', 'reason', 'notes', 'referenceNumber', 'recordedAtEpochMs', 'contentHash', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'localId', 'partyType', 'partyLocalId', 'sourceType', 'sourceId', 'amountPaise', 'paymentMethod', 'executionStatus', 'reason', 'notes', 'referenceNumber', 'subledgerEntryLocalId', 'recordedAtEpochMs', 'executedAtEpochMs', 'idempotencyKey', 'contentHash', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidRefundRecord(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(docId) &&
                         isValidRefundRecord(incoming(), userId) &&
                         existing().executionStatus == 'RECORDED_PENDING_PAYOUT' &&
                         incoming().executionStatus == 'PAYOUT_EXECUTED' &&
                         incoming().userId == existing().userId &&
                         incoming().localId == existing().localId &&
                         incoming().amountPaise == existing().amountPaise &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['paymentMethod', 'executionStatus', 'referenceNumber', 'subledgerEntryLocalId', 'notes', 'executedAtEpochMs', 'contentHash', 'updatedAt']);
        allow delete: if false;
      }

      // Permanent Financial Audit History: Strictly Create & Read Only (NEVER update or delete)
      match /financial_audit_logs/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'localId', 'operationType', 'entityType', 'entityId', 'actorLabel', 'reason', 'beforeJson', 'afterJson', 'operationReference', 'localCreatedAtMs', 'contentHash', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'localId', 'operationType', 'entityType', 'entityId', 'relatedPartyType', 'relatedPartyId', 'actorLabel', 'reason', 'beforeJson', 'afterJson', 'operationReference', 'localCreatedAtMs', 'contentHash', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidAuditLog(incoming(), userId);
        allow update, delete: if false;
      }

      match /expenses/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'localId', 'category', 'amountPaise', 'expenseDateEpochMs', 'paymentMethod', 'referenceNumber', 'notes', 'localCreatedAtMs', 'contentHash', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'localId', 'category', 'amountPaise', 'expenseDateEpochMs', 'paymentMethod', 'referenceNumber', 'notes', 'localCreatedAtMs', 'deletedAtEpochMs', 'contentHash', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidExpense(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(docId) &&
                         isValidExpense(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().localId == existing().localId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['category', 'amountPaise', 'expenseDateEpochMs', 'paymentMethod', 'referenceNumber', 'notes', 'deletedAtEpochMs', 'contentHash', 'updatedAt']);
        allow delete: if false;
      }

      match /payment_reminders/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'localId', 'customerLocalId', 'targetPhoneE164', 'dueKind', 'status', 'snapshotPendingInvoiceCount', 'snapshotTotalInvoicePaise', 'snapshotTotalInvoicePendingPaise', 'snapshotNetOutstandingPaise', 'renderedMessage', 'awaitingUserConfirmation', 'localCreatedAtMs', 'localUpdatedAtMs', 'contentHash', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'localId', 'customerLocalId', 'targetPhoneE164', 'dueKind', 'status', 'snapshotPendingInvoiceCount', 'snapshotTotalInvoicePaise', 'snapshotTotalInvoicePendingPaise', 'snapshotNetOutstandingPaise', 'renderedMessage', 'whatsappPackageUsed', 'failureReason', 'awaitingUserConfirmation', 'localCreatedAtMs', 'whatsappOpenedAtEpochMs', 'confirmedSentAtEpochMs', 'localUpdatedAtMs', 'contentHash', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidPaymentReminder(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(docId) &&
                         isValidPaymentReminder(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().localId == existing().localId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt);
        allow delete: if false;
      }

      match /payment_reminder_invoices/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'localId', 'reminderLocalId', 'salesInvoiceLocalId', 'invoiceDateSnapshotMs', 'totalAmountPaiseSnapshot', 'pendingAmountPaiseSnapshot', 'contentHash', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'localId', 'reminderLocalId', 'salesInvoiceLocalId', 'invoiceDateSnapshotMs', 'totalAmountPaiseSnapshot', 'pendingAmountPaiseSnapshot', 'contentHash', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidPaymentReminderInvoice(incoming(), userId);
        allow update, delete: if false;
      }

      match /app_settings/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'settingKey', 'settingValue', 'localUpdatedAtMs', 'contentHash', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'settingKey', 'settingValue', 'localUpdatedAtMs', 'contentHash', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidAppSetting(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(docId) &&
                         isValidAppSetting(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().settingKey == existing().settingKey &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt);
        allow delete: if isOwner(userId) && isValidId(docId);
      }
    }
  }
}
